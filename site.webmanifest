{
  "name": "Rita Beleza e Estética",
  "short_name": "Rita",
  "start_url": "/agendar?app=1",
  "display": "standalone",
  "background_color": "#fbf7f3",
  "theme_color": "#9c4a5e",
  "icons": [
    {
      "src": "/agendar/icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/agendar/icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/agendar/icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/agendar",
  "scope": "/",
  "lang": "pt-BR",
  "description": "Agende seu horário ou peça um orçamento na Rita Beleza e Estética.",
  "display_override": [
    "standalone"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://rita-estetica-e-beleza.vercel.app/site.webmanifest"
    }
  ]
}
